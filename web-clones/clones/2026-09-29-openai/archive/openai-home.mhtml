@keyframes fade-in {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes fade-out {=20
  0% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes content-show {=20
  0% { opacity: 0; translate: var(--tw-translate-x,-50%) var(--content-show=
-translate-y-from,-48%); scale: 0.96; }
  100% { opacity: 1; translate: var(--tw-translate-x,-50%) var(--content-sh=
ow-translate-y-to,-50%); scale: 1; }
}

@keyframes prompt-arrow-bounce {=20
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-25%); }
}

@keyframes safety-diagram-arrow-left {=20
  0% { transform: translate(0px); }
  40% { opacity: 1; transform: translate(-40px); }
  41% { opacity: 0; transform: translate(-40px); }
  59% { opacity: 0; transform: translate(40px); }
  60% { opacity: 1; transform: translate(40px); }
  100% { transform: translate(0px); }
}

@keyframes safety-diagram-arrow-right {=20
  0% { transform: translate(0px); }
  40% { opacity: 1; transform: translate(40px); }
  41% { opacity: 0; transform: translate(40px); }
  59% { opacity: 0; transform: translate(-40px); }
  60% { opacity: 1; transform: translate(-40px); }
  100% { transform: translate(0px); }
}

@keyframes search-loading-gradient {=20
  0% { background-position: 100% center; }
  100% { background-position: 0px center; }
}

@keyframes slide-in-start {=20
  0% { transform: translateX(calc(-100% * var(--dir,1))); }
  100% { transform: translate(0px); }
}

@keyframes slide-in-end {=20
  0% { transform: translateX(calc(100% * var(--dir,1))); }
  100% { transform: translate(0px); }
}

@keyframes slide-out-end {=20
  0% { transform: translate(0px); }
  100% { transform: translateX(calc(100% * var(--dir,1))); }
}

